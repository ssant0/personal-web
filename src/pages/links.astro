---
import Layout from "../layouts/Layout.astro";
import {socialLinks} from "../data/socialLinks";
---

<Layout
	title="Links — Manuel Samaniego"
	metaTitle="Links de Manuel Samaniego — Desarrollador Web"
	description="Todos mis links en un solo lugar. Portafolio, redes sociales y contacto."
	keywords="manuel samaniego, links, portafolio, desarrollador web, contacto"
>
	<main id="main" tabindex="-1" class="min-h-screen flex items-center justify-center px-4 py-16">
		<div class="w-full max-w-sm flex flex-col items-center gap-4">

			<!-- Avatar -->
			<div
				class="avatar-ring w-24 h-24 rounded-full bg-[#2d5d54] flex items-center justify-center ring-4 ring-[#2d5d54]/20   ">
				<span aria-hidden="true" class="text-white text-3xl font-semibold codec-pro tracking-tight">MS</span>
			</div>

			<!-- Badge -->
			<div id="links-badge" class="flex items-center gap-2 px-4 py-1.5 bg-[#2d5d54]/10 rounded-full">
				<span class="text-[#2d5d54] text-sm font-medium tracking-wide">&lt;/&gt;&nbsp;&nbsp;Desarrollador Web</span>
			</div>

			<!-- Name -->
			<h1 id="links-name" class="codec-pro text-3xl font-medium text-center">
				Manuel Samaniego
			</h1>

			<!-- Bio -->
			<p id="links-bio" class="text-sm text-center text-gray-600 max-w-[280px] leading-relaxed">
				Creo soluciones web a medida para pymes y emprendedores.
			</p>

			<!-- Divider -->
			<div id="links-divider" class="w-12 h-0.5 bg-[#2d5d54]/20 rounded-full my-1"></div>

			<!-- Links -->
			<div class="w-full flex flex-col gap-3">

				<!-- Portfolio -->
				<a
					href="/"
					class="link-card group w-full flex items-center gap-4 px-5 py-4 bg-[#2d5d54] text-white rounded-2xl transition duration-300 hover:bg-[#2c7c6e] hover:shadow-lg hover:shadow-[#2d5d54]/20"
				>
					<div class="w-9 h-9 bg-white/15 rounded-xl flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path
								d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354z"/>
						</svg>
					</div>
					<div class="flex-1 min-w-0">
						<p class="font-semibold text-sm leading-tight">Portafolio</p>
						<p class="text-white/70 text-xs">manuelsamaniego.com.mx</p>
					</div>
					<svg class="shrink-0 opacity-60 group-hover:translate-x-1 transition-transform duration-300"
					     xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill-rule="evenodd"
						      d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
					</svg>
				</a>

				<!-- Agencia -->
				<a
					href="https://labstudiomedia.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="link-card group w-full flex items-center gap-4 px-5 py-4 bg-white/80 backdrop-blur-sm border border-gray-200/60 rounded-2xl transition duration-300 hover:border-[#2d5d54]/40 hover:bg-white hover:shadow-md"
				>
					<div class="w-9 h-9 bg-[#2d5d54]/8 rounded-xl flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#2d5d54" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path
								d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022M6 8.694 1 10.36V15h5zM7 15h2v-1.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V15h2V1.309l-7 3.5z"/>
							<path
								d="M2 11h1v1H2zm2 0h1v1H4zm-2 2h1v1H2zm2 0h1v1H4zm4-4h1v1H8zm2 0h1v1h-1zm-2 2h1v1H8zm2 0h1v1h-1zm2-2h1v1h-1zm0 2h1v1h-1zM8 7h1v1H8zm2 0h1v1h-1zm2 0h1v1h-1zM8 5h1v1H8zm2 0h1v1h-1zm2 0h1v1h-1zm0-2h1v1h-1z"/>
						</svg>
					</div>
					<div class="flex-1 min-w-0">
						<p class="font-semibold text-sm leading-tight text-gray-800">Labstudiomedia</p>
						<p class="text-gray-600 text-xs">labstudiomedia.com</p>
					</div>
					<svg
						class="shrink-0 text-[#2d5d54] opacity-50 group-hover:translate-x-1 group-hover:opacity-100 transition duration-300"
						xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill-rule="evenodd"
						      d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
					</svg>
				</a>

				<!-- LinkedIn -->
				<a
					href={socialLinks.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="link-card group w-full flex items-center gap-4 px-5 py-4 bg-white/80 backdrop-blur-sm border border-gray-200/60 rounded-2xl transition duration-300 hover:border-[#2d5d54]/40 hover:bg-white hover:shadow-md"
				>
					<div class="w-9 h-9 bg-[#2d5d54]/8 rounded-xl flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#2d5d54" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path
								d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"/>
						</svg>
					</div>
					<div class="flex-1 min-w-0">
						<p class="font-semibold text-sm leading-tight text-gray-800">LinkedIn</p>
						<p class="text-gray-600 text-xs">in/manuel-samaniego</p>
					</div>
					<svg
						class="shrink-0 text-[#2d5d54] opacity-50 group-hover:translate-x-1 group-hover:opacity-100 transition duration-300"
						xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill-rule="evenodd"
						      d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
					</svg>
				</a>

				<!-- GitHub -->
				<a
					href={socialLinks.github}
					target="_blank"
					rel="noopener noreferrer"
					class="link-card group w-full flex items-center gap-4 px-5 py-4 bg-white/80 backdrop-blur-sm border border-gray-200/60 rounded-2xl transition duration-300 hover:border-[#2d5d54]/40 hover:bg-white hover:shadow-md"
				>
					<div class="w-9 h-9 bg-[#2d5d54]/8 rounded-xl flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#2d5d54" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
						</svg>
					</div>
					<div class="flex-1 min-w-0">
						<p class="font-semibold text-sm leading-tight text-gray-800">GitHub</p>
						<p class="text-gray-600 text-xs">{socialLinks.github.replace("https://", "")}</p>
					</div>
					<svg
						class="shrink-0 text-[#2d5d54] opacity-50 group-hover:translate-x-1 group-hover:opacity-100 transition duration-300"
						xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill-rule="evenodd"
						      d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
					</svg>
				</a>

				<!-- Instagram -->
				<a
					href={socialLinks.instagram}
					target="_blank"
					rel="noopener noreferrer"
					class="link-card group w-full flex items-center gap-4 px-5 py-4 bg-white/80 backdrop-blur-sm border border-gray-200/60 rounded-2xl transition duration-300 hover:border-[#2d5d54]/40 hover:bg-white hover:shadow-md"
				>
					<div class="w-9 h-9 bg-[#2d5d54]/8 rounded-xl flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#2d5d54" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
							<path
								d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
						</svg>
					</div>
					<div class="flex-1 min-w-0">
						<p class="font-semibold text-sm leading-tight text-gray-800">Instagram</p>
						<p class="text-gray-600 text-xs">@{socialLinks.instagram.split("/").filter(Boolean).pop()}</p>
					</div>
					<svg
						class="shrink-0 text-[#2d5d54] opacity-50 group-hover:translate-x-1 group-hover:opacity-100 transition duration-300"
						xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill-rule="evenodd"
						      d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
					</svg>
				</a>

				<!-- Email -->
				<a
					href=""
					data-email-href
					class="link-card group w-full flex items-center gap-4 px-5 py-4 bg-white/80 backdrop-blur-sm border border-gray-200/60 rounded-2xl transition duration-300 hover:border-[#2d5d54]/40 hover:bg-white hover:shadow-md"
				>
					<div class="w-9 h-9 bg-[#2d5d54]/8 rounded-xl flex items-center justify-center shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#2d5d54" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M19,1H5A5.006,5.006,0,0,0,0,6V18a5.006,5.006,0,0,0,5,5H19a5.006,5.006,0,0,0,5-5V6A5.006,5.006,0,0,0,19,1ZM5,3H19a3,3,0,0,1,2.78,1.887l-7.658,7.659a3.007,3.007,0,0,1-4.244,0L2.22,4.887A3,3,0,0,1,5,3ZM19,21H5a3,3,0,0,1-3-3V7.5L8.464,13.96a5.007,5.007,0,0,0,7.072,0L22,7.5V18A3,3,0,0,1,19,21Z"/>
						</svg>
					</div>
					<div class="flex-1 min-w-0">
						<p class="font-semibold text-sm leading-tight text-gray-800">Contacto</p>
						<p class="text-gray-600 text-xs truncate" data-email-text></p>
					</div>
					<svg
						class="shrink-0 text-[#2d5d54] opacity-50 group-hover:translate-x-1 group-hover:opacity-100 transition duration-300"
						xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
						<path fill-rule="evenodd"
						      d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
					</svg>
				</a>

			</div>

			<!-- Footer note -->
			<p id="links-footer" class="text-xs text-gray-600 mt-4">
				manuelsamaniego.com.mx
			</p>

		</div>
	</main>
</Layout>

<style>
	:global(.js) .avatar-ring,
	:global(.js) #links-badge,
	:global(.js) #links-name,
	:global(.js) #links-bio,
	:global(.js) #links-divider,
	:global(.js) .link-card,
	:global(.js) #links-footer {
		visibility: hidden;
	}

	.avatar-ring,
	#links-badge,
	#links-name,
	#links-bio,
	#links-divider,
	.link-card,
	#links-footer {
		will-change: transform;
	}

	.avatar-ring {
		box-shadow: 0 0 0 6px rgba(45, 93, 84, 0.12), 0 4px 20px rgba(45, 93, 84, 0.2);
	}

	.link-card:hover {
		transform: translateY(-1px);
	}
</style>

<script>
	import gsap from "gsap";
	import { hydrateEmail } from "../utils/email";
	hydrateEmail();

	const baseTo = {autoAlpha: 1, scale: 1, duration: 0.4, ease: "back.out"};

	gsap.set(".avatar-ring", {scale: 0});
	gsap.set("#links-badge", {scale: 0});
	gsap.set("#links-name", {scale: 0, y: 20});
	gsap.set("#links-bio", {scale: 0, y: 15});
	gsap.set("#links-divider", {scale: 0});
	gsap.set("#links-footer", {scale: 0});

	gsap.to(".avatar-ring", baseTo);
	gsap.to("#links-badge", {...baseTo, delay: 0.2});
	gsap.to("#links-name", {...baseTo, y: 0, delay: 0.4});
	gsap.to("#links-bio", {...baseTo, y: 0, delay: 0.6});
	gsap.to("#links-divider", {...baseTo, delay: 0.7});

	document.querySelectorAll<HTMLElement>(".link-card").forEach((card, i) => {
		card.classList.remove("transition", "duration-300");
		gsap.set(card, {scale: 0, y: 15});
		gsap.to(card, {
			...baseTo, y: 0, delay: 0.8 + i * 0.08,
			clearProps: "transform,opacity",
			onComplete: () => card.classList.add("transition", "duration-300"),
		});
	});

	gsap.to("#links-footer", {...baseTo, delay: 1.4});
</script>
