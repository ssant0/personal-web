---
import Layout from "../layouts/Layout.astro";
import Intro from "../views/home/sections/Intro.astro";
import AboutMe from "../views/home/sections/AboutMe.astro";
import Experience from "../views/home/sections/Experience.astro";
import Technologies from "../views/home/sections/Technologies.astro";
import RecentProjects from "../views/home/sections/RecentProjects.astro";
import Contact from "../views/shared/Contact.astro";
import NavBar from "../views/shared/NavBar.astro";
---

<Layout
	title="Manuel Samaniego | Ingeniero Full Stack (Java/Spring)"
	metaTitle="Manuel Samaniego | Ingeniero Full Stack Java & Spring Boot"
	description="Ingeniero Full Stack con foco en backend Java/Spring Boot y PostgreSQL. Construyo APIs y productos web y los despliego en Linux con Docker. Disponible para roles remotos o híbridos."
	keywords="ingeniero de software, backend developer, java, spring boot, postgresql, angular, typescript, docker, linux, api rest, software engineer, full stack, java developer, spring developer, devops"
>
	<NavBar />
	<main id="main" tabindex="-1" class="relative z-10 flex justify-center flex-col items-center">
		<Intro />
		<RecentProjects />
		<AboutMe />
		<Experience />
		<Technologies />
		<Contact />
	</main>
</Layout>
