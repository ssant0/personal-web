---
import {socialLinks} from "../../data/socialLinks";

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#202020] text-gray-400 border-t border-gray-800">
	<h2 class="sr-only">Pie de página</h2>
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
		<div
			class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 text-center md:text-left"
		>
			<div>
				<h3 class="text-lg text-white mb-2">Manuel Samaniego</h3>
				<p class="text-sm">
					&copy; {currentYear} Todos los derechos reservados.
				</p>
				<p class="text-xs mt-4">
					Hecho con ❤️ usando <a
					href="https://astro.build/"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-white underline decoration-dotted underline-offset-2"
				>Astro</a
				> & <a
					href="https://tailwindcss.com/"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-white underline decoration-dotted underline-offset-2"
				>Tailwind CSS</a
				>.
				</p>
			</div>
			<div>
				<h3 class="text-lg text-white mb-2">Navegación</h3>
				<ul class="flex flex-col gap-1 text-sm">
					<li><a href="/#intro" data-scroll="intro" class="hover:text-white transition-colors">Inicio</a></li>
					<li><a href="/#recent-projects" data-scroll="recent-projects" class="hover:text-white transition-colors">Proyectos</a>
					</li>
					<li><a href="/#contact" data-scroll="contact" class="hover:text-white transition-colors">Contacto</a></li>
				</ul>
			</div>
			<div>
				<h3 class="text-lg text-white mb-2">Conecta conmigo</h3>
				<div
					class="flex justify-center md:justify-start items-center gap-5 mt-4"
				>
					<a
						href={socialLinks.github}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
						class="hover:text-white transition-colors"
					>
						<svg
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							class="w-6 h-6"
							aria-hidden="true"
							focusable="false"
							viewBox="0 0 16 16"
						>
							<path
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
							></path>
						</svg>
					</a>
					<a
						href={socialLinks.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						class="hover:text-white transition-colors"
					>
						<svg
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							class="w-6 h-6"
							aria-hidden="true"
							focusable="false"
							viewBox="0 0 24 24"
						>
							<path
								d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
							></path>
						</svg>
					</a>
					<a
						href={socialLinks.instagram}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Instagram"
						class="hover:text-white transition-colors"
					>
						<svg
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							class="w-6 h-6"
							aria-hidden="true"
							focusable="false"
							viewBox="0 0 16 16"
						>
							<path
								d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"
							></path>
						</svg>
					</a>
				<a
					href=""
					data-email-href
					rel="noopener noreferrer"
					aria-label="Email"
					class="hover:text-white transition-colors"
				>
						<svg fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
							<path
								d="M19,1H5A5.006,5.006,0,0,0,0,6V18a5.006,5.006,0,0,0,5,5H19a5.006,5.006,0,0,0,5-5V6A5.006,5.006,0,0,0,19,1ZM5,3H19a3,3,0,0,1,2.78,1.887l-7.658,7.659a3.007,3.007,0,0,1-4.244,0L2.22,4.887A3,3,0,0,1,5,3ZM19,21H5a3,3,0,0,1-3-3V7.5L8.464,13.96a5.007,5.007,0,0,0,7.072,0L22,7.5V18A3,3,0,0,1,19,21Z"/>
						</svg>
					</a>
				</div>
			</div>
		</div>
		<!-- Legal bottom bar -->
		<div class="border-t border-gray-700 pt-6 flex justify-center">
			<a
				href="/aviso-de-privacidad"
				class="text-xs text-gray-400 hover:text-white transition-colors"
			>
				Aviso de Privacidad
			</a>
		</div>
	</div>
</footer>

<script>
	import { hydrateEmail } from "../../utils/email";
	hydrateEmail();

	document.querySelectorAll<HTMLAnchorElement>("[data-scroll]").forEach((link) => {
		link.addEventListener("click", (e) => {
			const target = document.getElementById(link.dataset.scroll!);
			if (!target) return;
			e.preventDefault();
			const top = link.dataset.scroll === "intro" ? 0 : target.offsetTop;
			window.scrollTo({top, behavior: "smooth"});
		});
	});
</script>
