---
import { socialLinks } from "../../data/socialLinks";

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#202020] text-gray-400 border-t border-gray-800">
	<h2 class="sr-only">Pie de página</h2>
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 text-center md:text-left">
			<div>
				<h3 class="text-lg text-white mb-2">Manuel Samaniego</h3>
				<p class="text-sm">
					&copy; {currentYear} Todos los derechos reservados.
				</p>
				<p class="text-xs mt-4">
					Hecho con ❤️ usando <a
						href="https://astro.build/"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-white underline decoration-dotted underline-offset-2">Astro</a
					> & <a
						href="https://tailwindcss.com/"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-white underline decoration-dotted underline-offset-2">Tailwind CSS</a
					>.
				</p>
			</div>
			<div>
				<h3 class="text-lg text-white mb-2">Navegación</h3>
				<ul class="flex flex-col gap-1 text-sm">
					<li>
						<a href="/#intro" data-scroll="intro" class="hover:text-white transition-colors"
							>Inicio</a
						>
					</li>
					<li>
						<a
							href="/#recent-projects"
							data-scroll="recent-projects"
							class="hover:text-white transition-colors">Proyectos</a
						>
					</li>
					<li>
						<a
							href="/#experience"
							data-scroll="experience"
							class="hover:text-white transition-colors">Experiencia</a
						>
					</li>
					<li>
						<a href="/#contact" data-scroll="contact" class="hover:text-white transition-colors"
							>Contacto</a
						>
					</li>
				</ul>
			</div>
			<div>
				<h3 class="text-lg text-white mb-2">Conecta conmigo</h3>
				<div class="flex justify-center md:justify-start items-center gap-5 mt-4">
					<a
						href={socialLinks.github}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
						class="hover:text-white transition-colors"
					>
						<svg
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							class="w-6 h-6"
							aria-hidden="true"
							focusable="false"
							viewBox="0 0 16 16"
						>
							<path
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
							></path>
						</svg>
					</a>
					<a
						href={socialLinks.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
						class="hover:text-white transition-colors"
					>
						<svg
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							class="w-6 h-6"
							aria-hidden="true"
							focusable="false"
							viewBox="0 0 24 24"
						>
							<path
								d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
							></path>
						</svg>
					</a>
					<a
						href={`mailto:${socialLinks.email}`}
						rel="noopener noreferrer"
						aria-label="Email"
						class="hover:text-white transition-colors"
					>
						<svg
							fill="currentColor"
							xmlns="http://www.w3.org/2000/svg"
							class="w-6 h-6"
							aria-hidden="true"
							focusable="false"
							viewBox="0 0 24 24"
						>
							<path
								d="M19,1H5A5.006,5.006,0,0,0,0,6V18a5.006,5.006,0,0,0,5,5H19a5.006,5.006,0,0,0,5-5V6A5.006,5.006,0,0,0,19,1ZM5,3H19a3,3,0,0,1,2.78,1.887l-7.658,7.659a3.007,3.007,0,0,1-4.244,0L2.22,4.887A3,3,0,0,1,5,3ZM19,21H5a3,3,0,0,1-3-3V7.5L8.464,13.96a5.007,5.007,0,0,0,7.072,0L22,7.5V18A3,3,0,0,1,19,21Z"
							></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
		<!-- Legal bottom bar -->
		<div class="border-t border-gray-700 pt-6 flex justify-center">
			<a
				href="/aviso-de-privacidad"
				class="text-xs text-gray-400 hover:text-white transition-colors"
			>
				Aviso de Privacidad
			</a>
		</div>
	</div>
</footer>

<script>
	document.querySelectorAll<HTMLAnchorElement>("[data-scroll]").forEach((link) => {
		link.addEventListener("click", (e) => {
			// Respeta clic con modificadores (abrir en pestaña nueva, etc.)
			if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

			if (link.dataset.scroll === "intro") {
				e.preventDefault();
				window.scrollTo({ top: 0, behavior: "smooth" });
				return;
			}
			const target = document.getElementById(link.dataset.scroll!);
			if (!target) return;
			e.preventDefault();
			target.scrollIntoView({ behavior: "smooth", block: "start" });
		});
	});
</script>
