---

<nav
	id="navbar"
	aria-label="Principal"
	class="sticky top-0 w-full z-50 flex justify-center
	py-3 px-16
	max-[660px]:px-0 max-[660px]:py-0"
>
	<div
		id="links-container"
		class="bg-white/80 backdrop-blur-md border border-gray-200/60
    py-3 px-5
    rounded-2xl shadow-md flex items-center justify-center text-xl gap-8
    max-[660px]:text-lg max-[660px]:gap-3 max-[382px]:text-base
    transition-colors duration-300
    max-[660px]:w-full max-[660px]:justify-center max-[660px]:rounded-none max-[480px]:text-base"
	>
		<a
			href="#intro"
			data-target="intro"
			aria-current="location"
			class="lb active cursor-pointer px-4 py-1 rounded-xl hover:text-[#2d5d54] transition-colors duration-300 border-2 border-solid border-transparent
      max-[382px]:px-2 max-[382px]:py-0.5
      w-34 max-[660px]:w-32 max-[480px]:w-28"
		>Inicio</a>

		<a
			href="#recent-projects"
			data-target="recent-projects"
			class="lb cursor-pointer px-4 py-1 rounded-xl hover:text-[#2d5d54] transition-colors duration-300 border-2 border-solid border-transparent
      max-[382px]:px-2 max-[382px]:py-0.5
      w-34 max-[660px]:w-32 max-[480px]:w-28"
		>Proyectos</a>

		<!-- Oculto en mobile — sección accesible por scroll -->
		<a
			href="#about"
			data-target="about"
			class="lb cursor-pointer px-4 py-1 rounded-xl hover:text-[#2d5d54] transition-colors duration-300 border-2 border-solid border-transparent
      max-[382px]:px-2 max-[382px]:py-0.5
      w-34 max-[660px]:hidden"
		>Sobre mí</a>

		<a
			href="#contact"
			data-target="contact"
			class="lb cursor-pointer px-4 py-1 rounded-xl hover:text-[#2d5d54] transition-colors duration-300 border-2 border-solid border-transparent
      max-[382px]:px-2 max-[382px]:py-0.5
      w-34 max-[660px]:w-32 max-[480px]:w-28 text-center"
		>Contacto</a>
	</div>
</nav>

<script>
	import gsap from "gsap";

	const nav = document.getElementById("navbar");
	const links = document.querySelectorAll<HTMLAnchorElement>(".lb");

	// Expone la altura real del nav para que scroll-margin-top la respete
	const setNavHeight = () => {
		if (nav) document.documentElement.style.setProperty("--nav-height", `${nav.offsetHeight}px`);
	};
	setNavHeight();
	window.addEventListener("resize", setNavHeight);

	// Animación de entrada
	links.forEach((link) => gsap.set(link, { scale: 0 }));
	gsap.to("#links-container", {
		autoAlpha: 1, duration: 0.5, ease: "power2.out", onComplete: () => {
			links.forEach((link, i) => {
				gsap.to(link, { autoAlpha: 1, scale: 1, ease: "back.out", duration: 0.4, delay: i * 0.15 });
			});
		},
	});

	// Mapa sección → enlace usando data-target
	const getSection = (id: string): HTMLElement | null =>
		document.getElementById(id);

	const setActive = (link: HTMLAnchorElement) => {
		links.forEach((l) => {
			l.classList.remove("active");
			l.removeAttribute("aria-current");
		});
		link.classList.add("active");
		link.setAttribute("aria-current", "location");
	};

	const sectionLinkMap = new Map<Element, HTMLAnchorElement>();

	links.forEach((link) => {
		const targetId = link.dataset.target!;
		const section = getSection(targetId);
		if (section) sectionLinkMap.set(section, link);
	});

	// Observer — marca el link activo según la sección visible
	const observerOptions = { root: null, rootMargin: "0px", threshold: 0.25 };

	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (!entry.isIntersecting) return;
			const mappedLink = sectionLinkMap.get(entry.target);
			// Si el link está oculto en mobile (display:none), no cambia el estado activo
			if (!mappedLink || mappedLink.offsetParent === null) return;
			setActive(mappedLink);
		});
	}, observerOptions);

	const startObserver = () => {
		sectionLinkMap.forEach((_, section) => observer.observe(section));
	};
	startObserver();

	// Mueve el foco al encabezado destino para que el SR anuncie la sección
	const focusSection = (section: HTMLElement) => {
		const heading = section.querySelector<HTMLElement>("h1, h2, h3");
		if (!heading) return;
		heading.setAttribute("tabindex", "-1");
		heading.focus({ preventScroll: true });
	};

	// Scroll suave al hacer click — respeta scroll-margin-top de cada sección
	links.forEach((link) => {
		link.addEventListener("click", (e) => {
			// Respeta clic con modificadores (abrir en pestaña nueva, etc.)
			if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

			const targetId = link.dataset.target!;
			const section = getSection(targetId);
			if (!section) return;

			e.preventDefault();

			setActive(link);
			observer.disconnect();

			if (targetId === "intro") {
				window.scrollTo({ top: 0, behavior: "smooth" });
			} else {
				section.scrollIntoView({ behavior: "smooth", block: "start" });
			}
			focusSection(section);

			setTimeout(startObserver, 800);
		});
	});
</script>

<style>
	:global(.js) #links-container,
	:global(.js) .lb {
		visibility: hidden;
	}

	.lb {
		display: inline-block;
		text-align: center;
		will-change: transform;
	}

	.lb.active {
		border-color: #2d5d54;
		color: #2d5d54;
		background-color: rgba(45, 93, 84, 0.08);
	}
</style>