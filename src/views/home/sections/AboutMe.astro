---
---

<div
	id="about"
	class="flex flex-col items-center justify-center mt-52 max-[660px]:mt-30 px-6"
>
	<p id="about-eyebrow" class="text-xs font-semibold tracking-widest text-[#2d5d54] uppercase mb-2">— SOBRE MÍ</p>
	<h2
		id="about-title"
		class="pt-1 text-6xl text-center rubik max-[800px]:text-5xl max-[660px]:text-4xl max-[382px]:text-3xl"
	>
		Quién soy
	</h2>

	<div id="about-body" class="mt-12 max-w-2xl w-full flex flex-col gap-5">
		<p class="text-lg text-gray-600 leading-relaxed max-[660px]:text-base">
			Soy Manuel Samaniego, desarrollador Full Stack autodidacta con más de un año
			construyendo aplicaciones web que van a producción.
		</p>
		<p class="text-lg text-gray-600 leading-relaxed max-[660px]:text-base">
			Mi stack principal es Java y Spring Boot en el backend, Angular y TypeScript
			en el frontend. Me gusta entender el sistema completo — de la base de datos
			a la interfaz.
		</p>
		<p class="text-lg text-gray-600 leading-relaxed max-[660px]:text-base">
			Aprendo haciendo, y me mueve ver el impacto del código en algo concreto:
			un negocio que opera mejor, un usuario que ya no tiene que llamar por
			teléfono, un proceso que antes era manual y ahora no.
		</p>
		<p class="text-lg text-gray-600 leading-relaxed max-[660px]:text-base">
			Disponible para posiciones remotas, híbridas o presenciales en
			Los Mochis, Sinaloa.
		</p>
	</div>
</div>

<style>
	:global(.js) #about-eyebrow,
	:global(.js) #about-title,
	:global(.js) #about-body p {
		visibility: hidden;
	}

	#about-eyebrow,
	#about-title {
		will-change: transform;
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const headTrigger = { trigger: "#about", start: "top 80%" };
	const fadeUp = { autoAlpha: 1, y: 0, duration: 0.45, ease: "power2.out" };

	gsap.set("#about-eyebrow", { y: 10 });
	gsap.set("#about-title",   { y: 18 });

	gsap.to("#about-eyebrow", { ...fadeUp, scrollTrigger: headTrigger });
	gsap.to("#about-title",   { ...fadeUp, delay: 0.15, scrollTrigger: headTrigger });

	// Párrafos con stagger manual para que entren en cascada
	const bodyTrigger = { trigger: "#about-body", start: "top 85%" };
	const paragraphs = document.querySelectorAll("#about-body p");

	paragraphs.forEach((p, i) => {
		gsap.set(p, { y: 12 });
		gsap.to(p, {
			...fadeUp,
			delay: i * 0.12,
			scrollTrigger: bodyTrigger,
		});
	});
</script>
